---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ExternalLinkIcon from '../assets/external-link.svg';

interface Props {
  imageSrc: string;
  name: string;
  pronouns: string[];
  role: string;
  creds: string[];
  desc: string[];
  highlight: string;
  highlightDesc: string;
  highlightLinks: {
    to: string;
    text: string;
  }[];
}
const { imageSrc, name, pronouns, role, creds, desc, highlight, highlightDesc, highlightLinks } =
  Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/team/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
---

<div class="member">
  <div class="member-img-wrapper">
    <Image src={images[`../assets/team/${imageSrc}`]?.default} alt="" class="member-img" />
  </div>
  <div class="member-details">
    <div class="member-title">
      <h2 class="member-name">{name}</h2>
      <span class="member-pronouns">{pronouns.join('/')}</span>
    </div>
    <p class="member-role">{role}</p>
    <ul class="member-creds">
      {creds.map((cred) => <li class="member-cred">{cred}</li>)}
    </ul>
    {desc.map((paragraph) => <p class="member-desc">{paragraph}</p>)}
    <div class="member-highlights">
      <h3 class="member-highlights-title">{highlight}</h3>
      <p class="member-highlights-desc">{highlightDesc}</p>
      <div class="member-highlights-links">
        {
          highlightLinks.map((link) => (
            <a class="member-highlights-link light-link" href={link.to} target="_blank">
              {link.text}
              <ExternalLinkIcon
                role="img"
                aria-label="Opens in a new tab"
                fill="currentColor"
                width={8}
                height={8}
              />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</div>

<style>
  .member {
    border-radius: 1rem;
    border: 0.0625rem solid rgb(227, 229, 242);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .member-img-wrapper {
    width: 100%;
    max-width: 300px;
    aspect-ratio: 4 / 5;
  }

  .member-img {
    border-radius: 1rem;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .member-details {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .member-title,
  .member-creds,
  .member-highlights-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
  }

  .member-name {
    font-size: 1.25rem;
    font-weight: 800;
  }

  .member-pronouns {
    border-radius: 1000px;
    padding: 0.125rem 0.5rem;
    background-color: #e9f1fe;
    color: #14508e;
    font-size: 0.75rem;
  }

  .member-role {
    font-weight: 800;
    color: #0866d3;
  }

  .member-role,
  .member-desc {
    font-size: 1rem;
  }

  .member-cred {
    border-radius: 1000px;
    border: 0.0625rem solid #f5beec;
    padding: 0.25rem 0.75rem;
    background-color: #fde8f9;
    color: #8d0e66;
    font-size: 0.75rem;
  }

  .member-highlights {
    border-top: 0.0625rem solid #e3e5f2;
    padding-top: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .member-highlights-title {
    color: #42427c;
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .member-highlights-desc,
  .member-highlights-link {
    font-size: 0.875rem;
  }

  .member-highlights-link {
    text-decoration: none;
    border-bottom: 0.125rem solid currentColor;
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    font-weight: 600;
    line-height: 1;
  }

  @media screen and (min-width: 37.5em) {
    .member-name {
      font-size: 1.5rem;
    }

    .member-desc {
      font-size: 1.25rem;
    }

    .member-highlights-desc {
      font-size: 1rem;
    }

    .member-highlights-links {
      gap: 0.875rem;
    }
  }

  @media screen and (min-width: 48em) {
    .member {
      flex-direction: row;
      align-items: flex-start;
    }

    .member-img-wrapper {
      flex: 1 1 240px;
    }

    .member-details {
      flex: 2.5 1 400px;
    }
  }

  @media screen and (min-width: 64em) {
    .member {
      max-width: 1080px;
      margin: 0 auto;
      padding: 2.25rem;
      gap: 2.25rem;
    }

    .member-highlights-links {
      gap: 1rem;
    }
  }
</style>
